@{
    ViewData["Title"] = "Upload";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="badge text-bg-primary mb-2">Azure Blob Storage</span>
                    <h1 class="h3 mb-2">Upload an image</h1>
                    <p class="text-muted mb-0">
                        Send a photo to the <code>uploads</code> container.
                    </p>
                </div>

                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success" role="status">@success</div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <form asp-action="Index" asp-controller="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="image" class="form-label fw-semibold">Image file</label>
                        <input id="image"
                               name="image"
                               type="file"
                               accept="image/*"
                               required
                               class="form-control" />
                        <div class="form-text">Supported: JPG, PNG, GIF, WebP</div>
                    </div>

                    <div id="preview" class="mb-4" hidden>
                        <label class="form-label fw-semibold">Preview</label>
                        <div class="preview-frame border rounded bg-body-tertiary p-3 text-center">
                            <img id="preview-image" class="preview-image img-fluid rounded" alt="Selected image preview" />
                            <p class="small text-muted mt-2 mb-0 text-truncate" data-file-label></p>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg">Upload image</button>
                </form>
            </div>
        </div>
    </div>
</div>
