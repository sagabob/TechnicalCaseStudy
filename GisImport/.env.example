# Postgres connection (PostGIS required). Cloud hosts need sslmode=require.
# Example local: postgresql://postgres:postgres@localhost:5432/gisimport
# Example Aiven: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# MongoDB (Atlas or other). Database defaults to ccc_db.
# Example: mongodb+srv://USER:PASSWORD@HOST/ccc_db?appName=App
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/ccc_db
# MONGO_DB=ccc_db
# MONGO_COLLECTIONS=place_names,street_addresses,parks,ratingunits
# MONGO_BATCH_SIZE=500

# Optional overrides (defaults shown)
# DB_SCHEMA=ccc
# GEOMETRY_SRID=4326
# DATA_ORIGIN=data/Origin
# SCHEMA_SQL=sql/001_schema.sql
# FUNCTIONS_SQL=sql/002_spatial_functions.sql
# PLACE_NAME_FOLDER=vwPlaceName
# PARK_FOLDER=vwPark
# STREET_ADDRESS_FOLDER=vwStreetAddress
# RATING_UNIT_FOLDER=vwRatingUnit
# GEOJSON_GLOB=*.geojson
# COMMIT_EVERY=200
